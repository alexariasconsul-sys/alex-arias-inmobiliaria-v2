# Ejemplo de archivo .env
# Copia esto a .env y llena con tus valores (NO subas .env a git)

# Puerto (por defecto 3000)
PORT=3000

# Dominio (para URLs internas)
DOMAIN=https://tudominio.com

# Node environment
NODE_ENV=production

# Nota: Las claves API (Facebook Pixel, Anthropic, Google Client ID, etc)
# se configuran desde el panel admin en /admin
# Integraciones > API Keys

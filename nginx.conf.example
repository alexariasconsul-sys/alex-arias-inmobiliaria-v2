# /etc/nginx/sites-available/alexariasc.com
# Para aplicar:
#   cp /var/www/alex-arias-inmobiliaria/nginx.conf.example /etc/nginx/sites-available/alexariasc.com
#   nginx -t && systemctl reload nginx

# ── 1. HTTP → siempre redirige a https://alexariasc.com (sin www)
server {
    listen 80;
    server_name alexariasc.com www.alexariasc.com;
    return 301 https://alexariasc.com$request_uri;
}

# ── 2. HTTPS www → redirige a https://alexariasc.com (sin www)
server {
    listen 443 ssl;
    server_name www.alexariasc.com;

    ssl_certificate     /etc/letsencrypt/live/alexariasc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alexariasc.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://alexariasc.com$request_uri;
}

# ── 3. HTTPS alexariasc.com → servidor principal
server {
    listen 443 ssl;
    server_name alexariasc.com;

    client_max_body_size 100M;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    ssl_certificate     /etc/letsencrypt/live/alexariasc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alexariasc.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;
}
